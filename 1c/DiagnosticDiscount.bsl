// Диагностика (ТОЛЬКО ЧТЕНИЕ): где в ЗаказНаряде хранится скидка.
// Выводит в окно сообщений реквизиты шапки со словом "скидк", все реквизиты
// табличных частей и значения первых строк у заказ-наряда НомерДокумента.

Процедура КнопкаВыполнитьНажатие(Кнопка)

    НомерДокумента = "ЭПЭП003092";

    // --- 1. Реквизиты шапки со словом "скидк" ---
    Сообщить("=== Реквизиты ШАПКИ ЗаказНаряд со словом 'скидк' ===");
    ПоляШапки = Новый Массив;
    Для Каждого Реквизит Из Метаданные.Документы.ЗаказНаряд.Реквизиты Цикл
        Если СтрНайти(НРег(Реквизит.Имя + " " + Реквизит.Синоним), "скидк") > 0 Тогда
            Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним + " | " + Строка(Реквизит.Тип));
            ПоляШапки.Добавить(Реквизит.Имя);
        КонецЕсли;
    КонецЦикла;

    // --- 2. Все реквизиты всех табличных частей ---
    Для Каждого ТЧ Из Метаданные.Документы.ЗаказНаряд.ТабличныеЧасти Цикл
        Сообщить("=== Табличная часть " + ТЧ.Имя + " (" + ТЧ.Синоним + ") - реквизиты ===");
        Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
            Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним + " | " + Строка(Реквизит.Тип));
        КонецЦикла;
    КонецЦикла;

    // --- 3. Находим сам заказ-наряд ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    | ЗаказНаряд.Ссылка КАК Ссылка
    |ИЗ
    | Документ.ЗаказНаряд КАК ЗаказНаряд
    |ГДЕ
    | ЗаказНаряд.Номер = &Номер";
    Запрос.УстановитьПараметр("Номер", НомерДокумента);
    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Сообщить("Заказ-наряд " + НомерДокумента + " не найден");
        Возврат;
    КонецЕсли;

    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Док = Выборка.Ссылка;

    // --- 4. Значения "скидочных" реквизитов шапки у этого заказ-наряда ---
    Сообщить("=== " + НомерДокумента + ": значения реквизитов шапки со словом 'скидк' ===");
    Если ПоляШапки.Количество() > 0 Тогда
        ТекстПолей = "";
        Для Каждого Имя Из ПоляШапки Цикл
            ТекстПолей = ТекстПолей + ?(ТекстПолей = "", "", ", ") + "Д." + Имя + " КАК " + Имя;
        КонецЦикла;
        ЗапросШапки = Новый Запрос;
        ЗапросШапки.Текст = "ВЫБРАТЬ " + ТекстПолей + " ИЗ Документ.ЗаказНаряд КАК Д ГДЕ Д.Ссылка = &Ссылка";
        ЗапросШапки.УстановитьПараметр("Ссылка", Док);
        ВыборкаШапки = ЗапросШапки.Выполнить().Выбрать();
        Если ВыборкаШапки.Следующий() Тогда
            Для Каждого Имя Из ПоляШапки Цикл
                Сообщить(Имя + " = " + Строка(ВыборкаШапки[Имя]));
            КонецЦикла;
        КонецЕсли;
    Иначе
        Сообщить("(в шапке нет реквизитов со словом 'скидк')");
    КонецЕсли;

    // --- 5. Первые строки каждой табличной части и итог по реквизиту "Сумма" ---
    Для Каждого ТЧ Из Метаданные.Документы.ЗаказНаряд.ТабличныеЧасти Цикл

        Сообщить("=== " + НомерДокумента + ": " + ТЧ.Имя + " - первые 4 строки ===");

        ИменаРеквизитов = Новый Массив;
        ТекстПолей = "Т.НомерСтроки КАК НомерСтроки";
        Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
            ИменаРеквизитов.Добавить(Реквизит.Имя);
            ТекстПолей = ТекстПолей + ", Т." + Реквизит.Имя + " КАК " + Реквизит.Имя;
        КонецЦикла;

        ЗапросТЧ = Новый Запрос;
        ЗапросТЧ.Текст = "ВЫБРАТЬ " + ТекстПолей
            + " ИЗ Документ.ЗаказНаряд." + ТЧ.Имя + " КАК Т"
            + " ГДЕ Т.Ссылка = &Ссылка УПОРЯДОЧИТЬ ПО НомерСтроки";
        ЗапросТЧ.УстановитьПараметр("Ссылка", Док);
        ВыборкаТЧ = ЗапросТЧ.Выполнить().Выбрать();

        Количество = 0;
        СуммаИтого = 0;
        Пока ВыборкаТЧ.Следующий() Цикл
            Количество = Количество + 1;
            Если Количество <= 4 Тогда
                ТекстСтроки = "";
                Для Каждого Имя Из ИменаРеквизитов Цикл
                    ТекстСтроки = ТекстСтроки + Имя + "=" + Строка(ВыборкаТЧ[Имя]) + "; ";
                КонецЦикла;
                Сообщить("   " + ТекстСтроки);
            КонецЕсли;
            Если ИменаРеквизитов.Найти("Сумма") <> Неопределено Тогда
                Попытка
                    СуммаИтого = СуммаИтого + ВыборкаТЧ.Сумма;
                Исключение
                КонецПопытки;
            КонецЕсли;
        КонецЦикла;

        Сообщить("   строк: " + Количество + "; итог по реквизиту Сумма: " + Строка(СуммаИтого));

    КонецЦикла;

    Сообщить("=== Готово. Скопируйте весь этот текст из окна сообщений ===");

КонецПроцедуры

Процедура ПриОткрытии()

    КнопкаВыполнитьНажатие(Неопределено);

КонецПроцедуры
