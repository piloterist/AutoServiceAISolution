// Диагностика (ТОЛЬКО ЧТЕНИЕ): документ "Заявка на ремонт" в Альфа-Авто.
// Выводит в окно сообщений: найденное имя документа, все реквизиты шапки,
// табличные части с реквизитами, количество документов, связь с заказ-нарядом
// и значения всех реквизитов у заявки НомерДокумента (шапка + первые строки ТЧ).
// Вставьте в форму внешней обработки как КнопкаВыполнитьНажатие, как раньше.

Процедура КнопкаВыполнитьНажатие(Кнопка)

    НомерДокумента = "ЭП00000465";

    // --- 1. Ищем документ по имени/синониму ---
    Сообщить("=== Документы со словом 'заявк' в имени или синониме ===");
    МетаЗаявка = Неопределено;
    Для Каждого Док Из Метаданные.Документы Цикл
        Если СтрНайти(НРег(Док.Имя + " " + Док.Синоним), "заявк") > 0 Тогда
            Сообщить(Док.Имя + " | " + Док.Синоним);
            Если МетаЗаявка = Неопределено
                И СтрНайти(НРег(Док.Имя + " " + Док.Синоним), "ремонт") > 0 Тогда
                МетаЗаявка = Док;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Если МетаЗаявка = Неопределено Тогда
        Сообщить("Документ 'Заявка на ремонт' не найден");
        Возврат;
    КонецЕсли;

    ИмяДокумента = МетаЗаявка.Имя;
    Сообщить(">>> Используем: Документ." + ИмяДокумента + " (" + МетаЗаявка.Синоним + ")");

    // --- 2. Реквизиты шапки ---
    Сообщить("=== Реквизиты ШАПКИ " + ИмяДокумента + " ===");
    Для Каждого Реквизит Из МетаЗаявка.Реквизиты Цикл
        Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним + " | " + Строка(Реквизит.Тип));
    КонецЦикла;

    // --- 3. Табличные части ---
    Для Каждого ТЧ Из МетаЗаявка.ТабличныеЧасти Цикл
        Сообщить("=== Табличная часть " + ТЧ.Имя + " (" + ТЧ.Синоним + ") ===");
        Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
            Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним + " | " + Строка(Реквизит.Тип));
        КонецЦикла;
    КонецЦикла;

    // --- 4. Количество документов ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | КОЛИЧЕСТВО(*) КАК Всего,
    | МИНИМУМ(Д.Дата) КАК Первая,
    | МАКСИМУМ(Д.Дата) КАК Последняя
    |ИЗ
    | Документ." + ИмяДокумента + " КАК Д
    |ГДЕ
    | Д.ПометкаУдаления = ЛОЖЬ";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Сообщить("=== Документов (без пометки удаления): " + Выборка.Всего
            + ", первая: " + Строка(Выборка.Первая) + ", последняя: " + Строка(Выборка.Последняя));
    КонецЕсли;

    // --- 5. Где в метаданных ссылаются на заявку (связь с заказ-нарядом) ---
    Сообщить("=== Реквизиты других документов, чей тип включает заявку ===");
    Для Каждого Док Из Метаданные.Документы Цикл
        Для Каждого Реквизит Из Док.Реквизиты Цикл
            Если Реквизит.Тип.СодержитТип(Тип("ДокументСсылка." + ИмяДокумента)) Тогда
                Сообщить(Док.Имя + "." + Реквизит.Имя + " | " + Реквизит.Синоним);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Сообщить("=== Реквизиты заявки, ссылающиеся на ЗаказНаряд ===");
    Для Каждого Реквизит Из МетаЗаявка.Реквизиты Цикл
        Если Реквизит.Тип.СодержитТип(Тип("ДокументСсылка.ЗаказНаряд")) Тогда
            Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним);
        КонецЕсли;
    КонецЦикла;

    // --- 6. Сама заявка: значения шапки ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    | Д.Ссылка КАК Ссылка
    |ИЗ
    | Документ." + ИмяДокумента + " КАК Д
    |ГДЕ
    | Д.Номер ПОДОБНО &Номер";
    // Ищем по хвосту номера: буквы префикса могут быть латинскими.
    Запрос.УстановитьПараметр("Номер", "%" + Прав(НомерДокумента, 8));
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Сообщить("Заявка " + НомерДокумента + " не найдена, берём последнюю заявку");
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ." + ИмяДокумента
            + " КАК Д УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ";
        Результат = Запрос.Выполнить();
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Ссылка = Выборка.Ссылка;

    Сообщить("=== " + НомерДокумента + ": значения шапки ===");
    Сообщить("Дата = " + Строка(Ссылка.Дата) + "; Проведен = " + Строка(Ссылка.Проведен)
        + "; ПометкаУдаления = " + Строка(Ссылка.ПометкаУдаления));
    Для Каждого Реквизит Из МетаЗаявка.Реквизиты Цикл
        Попытка
            Значение = Ссылка[Реквизит.Имя];
            Сообщить(Реквизит.Имя + " = " + Строка(Значение));
        Исключение
            Сообщить(Реквизит.Имя + " = (не прочитан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
        КонецПопытки;
    КонецЦикла;

    // --- 7. Первые 3 строки каждой табличной части ---
    Для Каждого ТЧ Из МетаЗаявка.ТабличныеЧасти Цикл
        Сообщить("=== " + НомерДокумента + ": " + ТЧ.Имя + " - строк "
            + Ссылка[ТЧ.Имя].Количество() + ", первые 3 ===");
        Счетчик = 0;
        Для Каждого СтрокаТЧ Из Ссылка[ТЧ.Имя] Цикл
            Счетчик = Счетчик + 1;
            Если Счетчик > 3 Тогда
                Прервать;
            КонецЕсли;
            Текст = "#" + Строка(СтрокаТЧ.НомерСтроки) + ": ";
            Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
                Попытка
                    Текст = Текст + Реквизит.Имя + "=" + Строка(СтрокаТЧ[Реквизит.Имя]) + "; ";
                Исключение
                    Текст = Текст + Реквизит.Имя + "=(?); ";
                КонецПопытки;
            КонецЦикла;
            Сообщить(Текст);
        КонецЦикла;
    КонецЦикла;

    // --- 7а. Состояния заявок и заказ-наряды, созданные на их основании ---
    Сообщить("=== Состояния заявок (количество) ===");
    ЗапросСост = Новый Запрос;
    ЗапросСост.Текст =
    "ВЫБРАТЬ
    | Д.Состояние КАК Состояние,
    | КОЛИЧЕСТВО(*) КАК Кол
    |ИЗ
    | Документ." + ИмяДокумента + " КАК Д
    |ГДЕ
    | Д.ПометкаУдаления = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | Д.Состояние";
    ВыборкаСост = ЗапросСост.Выполнить().Выбрать();
    Пока ВыборкаСост.Следующий() Цикл
        Сообщить(Строка(ВыборкаСост.Состояние) + " : " + ВыборкаСост.Кол);
    КонецЦикла;

    Сообщить("=== Заказ-наряды с ДокументОснование = Заявка на ремонт (всего и 8 примеров) ===");
    ЗапросСвязи = Новый Запрос;
    ЗапросСвязи.Текст =
    "ВЫБРАТЬ
    | ЗН.Номер КАК НомерЗН,
    | ЗН.Дата КАК ДатаЗН,
    | ЗН.ДокументОснование КАК Заявка
    |ИЗ
    | Документ.ЗаказНаряд КАК ЗН
    |ГДЕ
    | ЗН.ПометкаУдаления = ЛОЖЬ
    | И ЗН.ДокументОснование ССЫЛКА Документ." + ИмяДокумента + "
    |УПОРЯДОЧИТЬ ПО
    | ЗН.Дата УБЫВ";
    ТаблСвязи = ЗапросСвязи.Выполнить().Выгрузить();
    Сообщить("Всего заказ-нарядов на основании заявок: " + ТаблСвязи.Количество());
    Сч = 0;
    Для Каждого СтрокаСвязи Из ТаблСвязи Цикл
        Сч = Сч + 1;
        Если Сч > 8 Тогда
            Прервать;
        КонецЕсли;
        Сообщить("ЗН " + СтрокаСвязи.НомерЗН + " от " + Строка(СтрокаСвязи.ДатаЗН)
            + "  <-  " + Строка(СтрокаСвязи.Заявка));
    КонецЦикла;

    // --- 8. Кто ссылается на заявки (связь заявка -> заказ-наряд) ---
    // Берём 80 последних заявок и ищем все объекты, которые на них ссылаются.
    Сообщить("=== Кто ссылается на 80 последних заявок (связь с заказ-нарядом) ===");
    ЗапросПоследних = Новый Запрос;
    ЗапросПоследних.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 80
    | Д.Ссылка КАК Ссылка
    |ИЗ
    | Документ." + ИмяДокумента + " КАК Д
    |ГДЕ
    | Д.ПометкаУдаления = ЛОЖЬ
    |УПОРЯДОЧИТЬ ПО
    | Д.Дата УБЫВ";
    МассивЗаявок = ЗапросПоследних.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

    Если МассивЗаявок.Количество() > 0 Тогда
        Ссылки = НайтиПоСсылкам(МассивЗаявок);
        Итоги = Новый Соответствие;
        Показано = 0;
        Для Каждого СтрокаСсылки Из Ссылки Цикл
            Если СтрокаСсылки.Данные = СтрокаСсылки.Ссылка Тогда
                Продолжить;
            КонецЕсли;
            ИмяМета = "";
            Попытка
                ИмяМета = СтрокаСсылки.Метаданные.ПолноеИмя();
            Исключение
                ИмяМета = "(?)";
            КонецПопытки;
            Итоги.Вставить(ИмяМета, ?(Итоги[ИмяМета] = Неопределено, 0, Итоги[ИмяМета]) + 1);
            Если Показано < 20 И СтрНайти(ИмяМета, "Документ.") > 0 Тогда
                Показано = Показано + 1;
                Сообщить("Заявка " + Строка(СтрокаСсылки.Ссылка) + "  <-  " + ИмяМета + ": " + Строка(СтрокаСсылки.Данные));
            КонецЕсли;
        КонецЦикла;
        Сообщить("--- Итого ссылок по типам объектов ---");
        Для Каждого Пара Из Итоги Цикл
            Сообщить(Пара.Ключ + " : " + Пара.Значение);
        КонецЦикла;
    КонецЕсли;

    // --- 9. Реквизиты заказ-наряда, похожие на связь с заявкой/основанием ---
    Сообщить("=== Реквизиты ЗаказНаряд со словами 'заяв', 'основан', 'документ' ===");
    Для Каждого Реквизит Из Метаданные.Документы.ЗаказНаряд.Реквизиты Цикл
        Имя = НРег(Реквизит.Имя + " " + Реквизит.Синоним);
        Если СтрНайти(Имя, "заяв") > 0 Или СтрНайти(Имя, "основан") > 0 Или СтрНайти(Имя, "документ") > 0 Тогда
            Сообщить(Реквизит.Имя + " | " + Реквизит.Синоним + " | " + Строка(Реквизит.Тип));
        КонецЕсли;
    КонецЦикла;

    Сообщить("=== Готово ===");

КонецПроцедуры
