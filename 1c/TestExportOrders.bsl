// ============================================================================
// TestExportOrders.epf — object module (полный текст модуля обработки)
// ============================================================================
//
// ВАРИАНТ ЧЕРЕЗ ЯНДЕКС.ДИСК REST API (не WebDAV!) — обходной путь на случай,
// если сеть 5Systems блокирует прямое HTTPS-соединение с Railway (firewall
// режет исходящий трафик на IP-диапазоны облачного хостинга). Вместо прямого
// POST в наш backend этот вариант кладёт JSON-файл на Яндекс.Диск через его
// REST API; backend сам периодически проверяет папку и импортирует новые
// файлы через тот же самый код, что и прямой API (см.
// backend/app/services/yandex_relay.py, DEPLOYMENT.md).
//
// ВАЖНО: изначально этот модуль использовал протокол WebDAV
// (webdav.yandex.ru) с Basic-авторизацией (логин + пароль приложения). Яндекс
// вернул "402 Payment Required: WebDAV is not available for the free
// тариф" — WebDAV у Яндекс.Диска доступен только на платных тарифах.
// Поэтому здесь используется REST API (cloud-api.yandex.net) с OAuth-
// токеном — тем же самым токеном, что уже настроен на backend
// (переменная окружения YANDEX_DISK_OAUTH_TOKEN), без ограничений
// по тарифу. Отдельный логин/пароль приложения больше не нужен.
//
// Это ПОЛНЫЙ текст модуля — весь код, который должен быть в редакторе модуля
// формы обработки. Форма (кнопка "Выполнить" и т.п.) — отдельные, не текстовые
// метаданные Конфигуратора; их менять не нужно. Событие ПриОткрытии уже
// привязано к процедуре ПриОткрытии() ниже (см. CLAUDE.md, раздел 25).
//
// Перед запуском замените ОДИН плейсхолдер ниже:
//   <YANDEX_OAUTH_TOKEN> — тот же OAuth-токен, что уже стоит на backend
//                          (переменная YANDEX_DISK_OAUTH_TOKEN)
//
// НОВОЕ в этой версии: добавлены Состояние (статус документа) и Цех
// (подразделение), а также табличные части "Работы" и "Товары" - строки
// работ и запчастей по каждому заказ-наряду. Табличные части читаются
// напрямую через ссылку на документ (Выборка.Ссылка.Работы /
// Выборка.Ссылка.Товары), а не через основной запрос - это стандартный и
// самый простой способ в 1С получить строки табличной части документа.
//
// НОВОЕ в этой версии: поле "Организация" (ЗаказНаряд.Организация) -
// organization в контракте импорта, тоже только в карточке заказ-наряда.
//
// ИЗМЕНЕНО в этой версии: период выгрузки начинается с 01.01.2025 (было
// 01.01.2026) - см. ДатаНачала ниже.
//
// НОВОЕ в этой версии: добавлены ещё 4 даты из реквизитов документа -
// ДатаСоздания, ДатаНачала, ДатаОкончания, ДатаЗакрытия (отдельные от
// обычного "Дата"). Именно ДатаЗакрытия теперь используется бэкендом для
// расчёта выручки на дашборде (заказ-наряд попадает в выручку того месяца,
// когда он был ЗАКРЫТ, а не создан). Если поле в 1С не заполнено (открытый
// заказ-наряд ещё не имеет ДатыЗакрытия), 1С хранит там не пустое
// значение, а "пустую дату" (01.01.0001) - её нельзя отправлять как есть,
// иначе бэкенд решит, что дата реально указана. Функция ДатаИлиНеопределено
// ниже проверяет это через ЗначениеЗаполнено() и шлёт JSON null вместо
// фиктивной даты.
//
// НОВОЕ в этой версии: добавлено поле "ВидРемонта" (ЗаказНаряд.ВидРемонта) -
// признак заказ-наряда (аварийный/гарантийный/плановый ремонт и т.п.).
// Бэкенд принимает его как repair_type; пока только сохраняется в БД, ни в
// какую отчётность/UI не выведен.
//
// НОВОЕ в этой версии: добавлен расчёт состояния оплаты заказ-наряда -
// deal_amount / debt_amount / paid_amount / payment_percent. Это НЕ
// собственная бизнес-логика - это воспроизведение штатного алгоритма 5S
// AUTO из процедуры пп_КлиентСервер.СписокЗаказНарядПоказатьПроцентОплаты(),
// которая сама читает РегистрНакопления.ВзаиморасчетыКомпании.Остатки().
// В 1С НЕТ реквизита ЗаказНаряд.ПроцентОплаты - это всегда вычисляемое
// значение, собираемое из документа + регистра взаиморасчётов, что этот
// код и делает.
//
// Штатная формула (сохранена как есть, без "улучшений" - знаки движений
// регистра уже учтены самим регистром):
//
//   СуммаСделки = Проведен
//       ? Окр(СуммаДокумента * КурсДокумента / (КурсВзаиморасчетов=0 ? 1 : КурсВзаиморасчетов), 2)
//       : 0
//
//   Сделки заказ-наряда = { Сам ЗН; ЗН.ДокументОснование; ЗН.ДокументОснование.ДокументОснование }
//
//   ДолгПоСделке = НезакрытыйЗН * СуммаСделки
//       + ЕСТЬNULL(Остаток по самому ЗН, 0)
//       + ЕСТЬNULL(Остаток по ДокументОснование, 0)
//       + ЕСТЬNULL(Остаток по ДокументОснование.ДокументОснование, 0)
//
//   Оплачено = СуммаСделки - ДолгПоСделке
//   ПроцентОплаты = СуммаСделки = 0 ? Неопределено : (1 - ДолгПоСделке / СуммаСделки) * 100
//
// Расчёт сделан ПАКЕТНО (один дополнительный запрос к регистру для всех
// выгружаемых ЗН сразу, через "Сделка В (&МассивВсехСделок)"), а не по
// одному ЗН за раз - иначе при массовой исторической выгрузке (тысячи
// документов) это была бы классическая проблема N+1 запросов. Основной
// запрос к Документ.ЗаказНаряд читается ОДИН раз в массив (первый проход),
// затем один запрос к регистру, затем второй проход по уже прочитанным
// строкам считает итоговые суммы и собирает JSON. Никаких изменений
// существующей логики выгрузки работ/товаров/дат/статуса/подразделения/
// source_key/Yandex Disk relay этот проход не затрагивает.
//
// ПроцентОплаты не ограничивается диапазоном 0..100 - штатная 1С допускает
// отрицательный процент и переплату (debt_amount < 0); это реальные данные
// для аналитики, а не ошибка, которую нужно "нормализовать".
// ============================================================================

Функция ДатаИлиНеопределено(ЗначениеДаты)

    Если ЗначениеЗаполнено(ЗначениеДаты) Тогда
        Возврат ЗначениеДаты;
    Иначе
        Возврат Неопределено;
    КонецЕсли;

КонецФункции

// Переносит платежи одной "Сделки" (МассивОткуда, может быть Неопределено,
// если по этой Сделке движений не было) в общий список платежей заказ-
// наряда (МассивКуда).
Процедура ДобавитьПлатежиСделки(МассивКуда, МассивОткуда)

    Если МассивОткуда = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Для Каждого Элемент Из МассивОткуда Цикл
        МассивКуда.Добавить(Элемент);
    КонецЦикла;

КонецПроцедуры

Процедура КнопкаВыполнитьНажатие(Кнопка)

    // --- 1. Запрос: все заказ-наряды начиная с даты ДатаНачала (массовая
    //        историческая выгрузка, не "последние 10"), вместе со всем
    //        необходимым для штатного расчёта оплаты 5S AUTO - прямо в
    //        самом запросе, без обращения к регистру для каждого ЗН по
    //        отдельности ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | ЗаказНаряд.Номер КАК Номер,
    | ЗаказНаряд.Дата КАК Дата,
    | ЗаказНаряд.Контрагент КАК Контрагент,
    | ЗаказНаряд.Автомобиль КАК Автомобиль,
    | ЗаказНаряд.СуммаДокумента КАК СуммаДокумента,
    | ЗаказНаряд.Состояние КАК Состояние,
    | ЗаказНаряд.Цех КАК Цех,
    | ЗаказНаряд.ВидРемонта КАК ВидРемонта,
    | ЗаказНаряд.Организация КАК Организация,
    | ЗаказНаряд.ДатаСоздания КАК ДатаСоздания,
    | ЗаказНаряд.ДатаНачала КАК ДатаНачала,
    | ЗаказНаряд.ДатаОкончания КАК ДатаОкончания,
    | ЗаказНаряд.ДатаЗакрытия КАК ДатаЗакрытия,
    | ЗаказНаряд.Ссылка КАК Ссылка,
    | ЗаказНаряд.ДокументОснование КАК ДокументОснование,
    | ЗаказНаряд.ДокументОснование.ДокументОснование КАК ОснованиеОснования,
    | ВЫБОР
    |     КОГДА ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
    |         ТОГДА 0
    |     ИНАЧЕ 1
    | КОНЕЦ КАК НезакрытыйЗаказНаряд,
    | ВЫБОР
    |     КОГДА ЗаказНаряд.Проведен
    |         ТОГДА ВЫРАЗИТЬ(
    |             ЗаказНаряд.СуммаДокумента * ЗаказНаряд.КурсДокумента /
    |             ВЫБОР
    |                 КОГДА ЗаказНаряд.КурсВалютыВзаиморасчетов = 0
    |                     ТОГДА 1
    |                 ИНАЧЕ ЗаказНаряд.КурсВалютыВзаиморасчетов
    |             КОНЕЦ
    |             КАК ЧИСЛО(10, 2)
    |         )
    |     ИНАЧЕ 0
    | КОНЕЦ КАК СуммаСделки
    |ИЗ
    | Документ.ЗаказНаряд КАК ЗаказНаряд
    |ГДЕ
    | ЗаказНаряд.Дата >= &ДатаНачала
    |
    |УПОРЯДОЧИТЬ ПО
    | ЗаказНаряд.Дата УБЫВ";

    // Начало периода выгрузки - поменяйте здесь, если нужен другой диапазон.
    Запрос.УстановитьПараметр("ДатаНачала", Дата(2025, 1, 1));

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    // --- 2. Первый проход: кэшируем строки результата запроса в массив
    //        (Выборка - это однонаправленный курсор, второй раз пройти по
    //        ней нельзя) и одновременно собираем ПОЛНЫЙ список "Сделок" -
    //        сам ЗН + его ДокументОснование + основание основания - для
    //        ОДНОГО пакетного запроса к регистру взаиморасчётов ниже ---
    СтрокиЗН = Новый Массив;
    МассивВсехСделок = Новый Массив;
    УжеДобавленныеСделки = Новый Соответствие;

    Пока Выборка.Следующий() Цикл

        Стр = Новый Структура;
        Стр.Вставить("Номер", Выборка.Номер);
        Стр.Вставить("Дата", Выборка.Дата);
        Стр.Вставить("Контрагент", Выборка.Контрагент);
        Стр.Вставить("Автомобиль", Выборка.Автомобиль);
        Стр.Вставить("СуммаДокумента", Выборка.СуммаДокумента);
        Стр.Вставить("Состояние", Выборка.Состояние);
        Стр.Вставить("Цех", Выборка.Цех);
        Стр.Вставить("ВидРемонта", Выборка.ВидРемонта);
        Стр.Вставить("Организация", Выборка.Организация);
        Стр.Вставить("ДатаСоздания", Выборка.ДатаСоздания);
        Стр.Вставить("ДатаНачала", Выборка.ДатаНачала);
        Стр.Вставить("ДатаОкончания", Выборка.ДатаОкончания);
        Стр.Вставить("ДатаЗакрытия", Выборка.ДатаЗакрытия);
        Стр.Вставить("Ссылка", Выборка.Ссылка);
        Стр.Вставить("ДокументОснование", Выборка.ДокументОснование);
        Стр.Вставить("ОснованиеОснования", Выборка.ОснованиеОснования);
        Стр.Вставить("НезакрытыйЗаказНаряд", Выборка.НезакрытыйЗаказНаряд);
        Стр.Вставить("СуммаСделки", Выборка.СуммаСделки);

        СтрокиЗН.Добавить(Стр);

        // Сама Ссылка (ЗН) всегда участвует как "Сделка" в регистре
        // взаиморасчётов; ДокументОснование/ОснованиеОснования - только
        // если реально заполнены (ЗначениеЗаполнено на пустой ссылке даёт
        // Ложь - см. ту же проверку в ДатаИлиНеопределено выше).
        Если УжеДобавленныеСделки[Выборка.Ссылка] = Неопределено Тогда
            МассивВсехСделок.Добавить(Выборка.Ссылка);
            УжеДобавленныеСделки.Вставить(Выборка.Ссылка, Истина);
        КонецЕсли;

        Если ЗначениеЗаполнено(Выборка.ДокументОснование)
            И УжеДобавленныеСделки[Выборка.ДокументОснование] = Неопределено Тогда
            МассивВсехСделок.Добавить(Выборка.ДокументОснование);
            УжеДобавленныеСделки.Вставить(Выборка.ДокументОснование, Истина);
        КонецЕсли;

        Если ЗначениеЗаполнено(Выборка.ОснованиеОснования)
            И УжеДобавленныеСделки[Выборка.ОснованиеОснования] = Неопределено Тогда
            МассивВсехСделок.Добавить(Выборка.ОснованиеОснования);
            УжеДобавленныеСделки.Вставить(Выборка.ОснованиеОснования, Истина);
        КонецЕсли;

    КонецЦикла;

    Сообщить("Найдено заказ-нарядов: " + СтрокиЗН.Количество());

    // --- 3. ОДИН пакетный запрос к РегистрНакопления.ВзаиморасчетыКомпании
    //        .Остатки() для всех собранных "Сделок" сразу - воспроизводит
    //        штатную логику
    //        пп_КлиентСервер.СписокЗаказНарядПоказатьПроцентОплаты() без
    //        обращения к регистру по одному ЗН за раз (N+1) ---
    ОстаткиПоСделкам = Новый Соответствие;

    Если МассивВсехСделок.Количество() > 0 Тогда

        ЗапросОстатков = Новый Запрос;
        ЗапросОстатков.Текст =
        "ВЫБРАТЬ
        | ОстаткиВзаиморасчетов.Сделка КАК Сделка,
        | ОстаткиВзаиморасчетов.СуммаОстаток КАК СуммаОстаток
        |ИЗ
        | РегистрНакопления.ВзаиморасчетыКомпании.Остатки(, Сделка В (&МассивВсехСделок)) КАК ОстаткиВзаиморасчетов";

        ЗапросОстатков.УстановитьПараметр("МассивВсехСделок", МассивВсехСделок);

        РезультатОстатков = ЗапросОстатков.Выполнить();
        ВыборкаОстатков = РезультатОстатков.Выбрать();

        Пока ВыборкаОстатков.Следующий() Цикл
            ОстаткиПоСделкам.Вставить(ВыборкаОстатков.Сделка, ВыборкаОстатков.СуммаОстаток);
        КонецЦикла;

    КонецЕсли;

    // --- 3b. ОДИН пакетный запрос "сырых" движений регистра взаиморасчётов
    //        по тем же Сделкам - но только те, что реально означают "пришли
    //        деньги": ВидДвижения=Расход. Фильтр по ВидОперации здесь не
    //        нужен - это подтверждено эмпирически по полному списку
    //        комбинаций из диагностики: во ВСЁМ регистре без единого
    //        исключения ВидДвижения=Расход встречается ТОЛЬКО с
    //        "Погашение дебиторской задолженности" либо "Начисление
    //        кредиторской задолженности" (оба - деньги пришли), а
    //        ВидДвижения=Приход - только с обратными двумя (просто
    //        разноска накладной/ЗН, не реальная оплата). Значит
    //        ВидДвижения=Расход сам по себе уже однозначно определяет
    //        нужные строки - сравнивать текст ВидОперации в запросе не
    //        требуется (там enum-поле, а язык запросов 1С не даёт удобно
    //        привести его к строке для сравнения - ни ВЫРАЗИТЬ КАК
    //        СТРОКА(), ни ВЫРАЗИТЬ(ПРЕДСТАВЛЕНИЕ(...)) не работают на
    //        перечислениях). Период каждой такой строки - реальная дата
    //        оплаты (дата документа-регистратора, например "Чек на
    //        оплату"), не дата самого ЗН. ---
    ПлатежиПоСделкам = Новый Соответствие;

    Если МассивВсехСделок.Количество() > 0 Тогда

        ЗапросПлатежей = Новый Запрос;
        ЗапросПлатежей.Текст =
        "ВЫБРАТЬ
        | ВзаиморасчетыКомпании.Сделка КАК Сделка,
        | ВзаиморасчетыКомпании.Период КАК Период,
        | ВзаиморасчетыКомпании.Сумма КАК Сумма,
        | ВзаиморасчетыКомпании.НомерСтроки КАК НомерСтроки,
        | ВзаиморасчетыКомпании.Регистратор КАК Регистратор
        |ИЗ
        | РегистрНакопления.ВзаиморасчетыКомпании КАК ВзаиморасчетыКомпании
        |ГДЕ
        | ВзаиморасчетыКомпании.Сделка В (&МассивВсехСделок)
        | И ВзаиморасчетыКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
        |
        |УПОРЯДОЧИТЬ ПО
        | Период";

        ЗапросПлатежей.УстановитьПараметр("МассивВсехСделок", МассивВсехСделок);

        РезультатПлатежей = ЗапросПлатежей.Выполнить();
        ВыборкаПлатежей = РезультатПлатежей.Выбрать();

        Пока ВыборкаПлатежей.Следующий() Цикл

            ЗаписьПлатежа = Новый Структура;
            ЗаписьПлатежа.Вставить("paid_at", ВыборкаПлатежей.Период);
            ЗаписьПлатежа.Вставить("amount", ВыборкаПлатежей.Сумма);
            ЗаписьПлатежа.Вставить("line_number", ВыборкаПлатежей.НомерСтроки);
            ЗаписьПлатежа.Вставить("source_document_id", Строка(ВыборкаПлатежей.Регистратор.УникальныйИдентификатор()));
            ЗаписьПлатежа.Вставить("source_document_type", Строка(ВыборкаПлатежей.Регистратор.Метаданные().Синоним));
            ЗаписьПлатежа.Вставить("source_document_number", Строка(ВыборкаПлатежей.Регистратор.Номер));

            СписокПлатежей = ПлатежиПоСделкам[ВыборкаПлатежей.Сделка];
            Если СписокПлатежей = Неопределено Тогда
                СписокПлатежей = Новый Массив;
                ПлатежиПоСделкам.Вставить(ВыборкаПлатежей.Сделка, СписокПлатежей);
            КонецЕсли;
            СписокПлатежей.Добавить(ЗаписьПлатежа);

        КонецЦикла;

    КонецЕсли;

    // --- 4. Второй проход по уже прочитанным строкам: считаем ДолгПоСделке
    //        / Оплачено / ПроцентОплаты по штатной формуле 5S AUTO и
    //        собираем records[] под контракт бэкенда ---
    МассивЗаписей = Новый Массив;

    Для Каждого Стр Из СтрокиЗН Цикл

        ДолгПоСамомуЗН = ОстаткиПоСделкам[Стр.Ссылка];
        Если ДолгПоСамомуЗН = Неопределено Тогда
            ДолгПоСамомуЗН = 0;
        КонецЕсли;

        ДолгПоДокументуОснованию = 0;
        Если ЗначениеЗаполнено(Стр.ДокументОснование) Тогда
            ЗначениеОстатка = ОстаткиПоСделкам[Стр.ДокументОснование];
            Если ЗначениеОстатка <> Неопределено Тогда
                ДолгПоДокументуОснованию = ЗначениеОстатка;
            КонецЕсли;
        КонецЕсли;

        ДолгПоОснованиюОснования = 0;
        Если ЗначениеЗаполнено(Стр.ОснованиеОснования) Тогда
            ЗначениеОстатка = ОстаткиПоСделкам[Стр.ОснованиеОснования];
            Если ЗначениеОстатка <> Неопределено Тогда
                ДолгПоОснованиюОснования = ЗначениеОстатка;
            КонецЕсли;
        КонецЕсли;

        // Штатная формула 5S AUTO
        // (пп_КлиентСервер.СписокЗаказНарядПоказатьПроцентОплаты) - знаки
        // движений регистра уже учтены самим регистром, здесь их не
        // трогаем и не "улучшаем".
        ДолгПоСделке = Стр.НезакрытыйЗаказНаряд * Стр.СуммаСделки
            + ДолгПоСамомуЗН
            + ДолгПоДокументуОснованию
            + ДолгПоОснованиюОснования;

        Оплачено = Стр.СуммаСделки - ДолгПоСделке;

        Если Стр.СуммаСделки = 0 Тогда
            ПроцентОплаты = Неопределено; // -> JSON null, не строка "---"
        Иначе
            ПроцентОплаты = Окр((1 - ДолгПоСделке / Стр.СуммаСделки) * 100, 2);
        КонецЕсли;

        // 4a. Строки табличной части "Работы" этого заказ-наряда.
        МассивРабот = Новый Массив;
        Для Каждого СтрокаРаботы Из Стр.Ссылка.Работы Цикл
            ЗаписьРаботы = Новый Структура;
            ЗаписьРаботы.Вставить("operation", Строка(СтрокаРаботы.Работа));
            ЗаписьРаботы.Вставить("price", СтрокаРаботы.Цена);
            ЗаписьРаботы.Вставить("amount", СтрокаРаботы.Сумма);
            МассивРабот.Добавить(ЗаписьРаботы);
        КонецЦикла;

        // 4b. Строки табличной части "Товары" этого заказ-наряда.
        МассивТоваров = Новый Массив;
        Для Каждого СтрокаТовара Из Стр.Ссылка.Товары Цикл
            ЗаписьТовара = Новый Структура;
            ЗаписьТовара.Вставить("item", Строка(СтрокаТовара.Номенклатура));
            ЗаписьТовара.Вставить("quantity", СтрокаТовара.Количество);
            ЗаписьТовара.Вставить("price", СтрокаТовара.Цена);
            ЗаписьТовара.Вставить("amount", СтрокаТовара.Сумма);
            МассивТоваров.Добавить(ЗаписьТовара);
        КонецЦикла;

        // 4c. Реальные платежи по этой Сделке - та же цепочка "Сделка +
        //     ДокументОснование + ОснованиеОснования", что и в расчёте
        //     ДолгПоСделке выше, чтобы платёж, проведённый против
        //     основания ЗН, тоже сюда попал.
        МассивПлатежей = Новый Массив;
        ДобавитьПлатежиСделки(МассивПлатежей, ПлатежиПоСделкам[Стр.Ссылка]);
        Если ЗначениеЗаполнено(Стр.ДокументОснование) Тогда
            ДобавитьПлатежиСделки(МассивПлатежей, ПлатежиПоСделкам[Стр.ДокументОснование]);
        КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ОснованиеОснования) Тогда
            ДобавитьПлатежиСделки(МассивПлатежей, ПлатежиПоСделкам[Стр.ОснованиеОснования]);
        КонецЕсли;

        Запись = Новый Структура;
        Запись.Вставить("number", Строка(Стр.Номер));
        Запись.Вставить("date", Стр.Дата);
        Запись.Вставить("customer", Строка(Стр.Контрагент));
        Запись.Вставить("car", Строка(Стр.Автомобиль));
        Запись.Вставить("amount", Стр.СуммаДокумента);
        Запись.Вставить("status", Строка(Стр.Состояние));
        Запись.Вставить("department", Строка(Стр.Цех));
        Запись.Вставить("repair_type", Строка(Стр.ВидРемонта));
        Запись.Вставить("organization", Строка(Стр.Организация));
        Запись.Вставить("created_date", ДатаИлиНеопределено(Стр.ДатаСоздания));
        Запись.Вставить("start_date", ДатаИлиНеопределено(Стр.ДатаНачала));
        Запись.Вставить("end_date", ДатаИлиНеопределено(Стр.ДатаОкончания));
        Запись.Вставить("closed_date", ДатаИлиНеопределено(Стр.ДатаЗакрытия));
        Запись.Вставить("source_key", Строка(Стр.Ссылка.УникальныйИдентификатор()));
        Запись.Вставить("labor", МассивРабот);
        Запись.Вставить("parts", МассивТоваров);
        Запись.Вставить("deal_amount", Стр.СуммаСделки);
        Запись.Вставить("debt_amount", ДолгПоСделке);
        Запись.Вставить("paid_amount", Оплачено);
        Запись.Вставить("payment_percent", ПроцентОплаты);
        Запись.Вставить("payment_events", МассивПлатежей);

        МассивЗаписей.Добавить(Запись);

    КонецЦикла;

    // --- 5. Собираем конверт батча под /api/v1/import/work-orders (тот же
    //        JSON-контракт, что и при прямой отправке в backend) ---
    Данные = Новый Структура;
    Данные.Вставить("source", "alpha-auto");
    Данные.Вставить("branch", "kahovka"); // при необходимости поменяйте на реальный филиал
    Данные.Вставить("entity", "work_orders");
    Данные.Вставить("exported_at", Формат(ТекущаяДата(), "ДФ=гггг-ММ-ддTчч:мм:сс"));
    ИдБатча = Формат(ТекущаяДата(), "ДФ=ггггММдд-ччммсс");
    Данные.Вставить("batch_id", ИдБатча);
    Данные.Вставить("records", МассивЗаписей);

    // --- 6. Сериализация в JSON ---
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ТелоJSON = ЗаписьJSON.Закрыть();

    // --- 7. Загрузка на Яндекс.Диск через REST API (не WebDAV) ---
    OAuthТокен = "<YANDEX_OAUTH_TOKEN>";
    ПутьНаДиске = "/1c-export/" + ИдБатча + ".json";

    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;

    // 7a. Запрашиваем у Яндекса одноразовую ссылку для загрузки файла.
    СоединениеAPI = Новый HTTPСоединение(
        "cloud-api.yandex.net",
        443,
        ,
        ,
        ,
        ,
        ЗащищенноеСоединение
    );

    // Свойство ПараметрыURL есть не во всех версиях платформы - собираем
    // query-строку вручную через давно существующую КодироватьСтроку.
    СтрокаЗапросаURL = "/v1/disk/resources/upload?path="
        + КодироватьСтроку(ПутьНаДиске, СпособКодированияСтроки.КодировкаURL)
        + "&overwrite=true";

    ЗапросСсылки = Новый HTTPЗапрос(СтрокаЗапросаURL);
    ЗапросСсылки.Заголовки.Вставить("Authorization", "OAuth " + OAuthТокен);

    ОтветСсылки = СоединениеAPI.ВызватьHTTPМетод("GET", ЗапросСсылки);

    Если ОтветСсылки.КодСостояния <> 200 Тогда
        Сообщить("Не удалось получить ссылку для загрузки. HTTP status: " + ОтветСсылки.КодСостояния);
        Сообщить("Ответ сервера: " + ОтветСсылки.ПолучитьТелоКакСтроку());
        Возврат;
    КонецЕсли;

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ОтветСсылки.ПолучитьТелоКакСтроку());
    ДанныеСсылки = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();

    ХрефЗагрузки = ДанныеСсылки.href;
    Сообщить("Получена ссылка на загрузку: " + ХрефЗагрузки);

    // 7b. Разбираем полученную ссылку на хост, порт и путь - она обычно
    //     ведёт на отдельный сервер загрузки (не cloud-api.yandex.net),
    //     иногда с явно указанным портом (host:port/путь).
    ПозицияСхемы = СтрНайти(ХрефЗагрузки, "://");
    Если ПозицияСхемы > 0 Тогда
        БезСхемы = Сред(ХрефЗагрузки, ПозицияСхемы + 3);
    Иначе
        БезСхемы = ХрефЗагрузки;
    КонецЕсли;

    ПозицияСлеша = СтрНайти(БезСхемы, "/");
    Если ПозицияСлеша > 0 Тогда
        ХостИПорт = Лев(БезСхемы, ПозицияСлеша - 1);
        ПутьЗагрузки = Сред(БезСхемы, ПозицияСлеша);
    Иначе
        ХостИПорт = БезСхемы;
        ПутьЗагрузки = "/";
    КонецЕсли;

    ПозицияДвоеточия = СтрНайти(ХостИПорт, ":");
    Если ПозицияДвоеточия > 0 Тогда
        ХостЗагрузки = Лев(ХостИПорт, ПозицияДвоеточия - 1);
        ПортЗагрузки = Число(Сред(ХостИПорт, ПозицияДвоеточия + 1));
    Иначе
        ХостЗагрузки = ХостИПорт;
        ПортЗагрузки = 443;
    КонецЕсли;

    Сообщить("Хост загрузки: " + ХостЗагрузки + ", порт: " + ПортЗагрузки + ", путь: " + ПутьЗагрузки);

    // 7c. Собственно загрузка файла на полученную ссылку.
    ЗащищенноеСоединение2 = Новый ЗащищенноеСоединениеOpenSSL;

    СоединениеЗагрузки = Новый HTTPСоединение(
        ХостЗагрузки,
        ПортЗагрузки,
        ,
        ,
        ,
        ,
        ЗащищенноеСоединение2
    );

    ЗапросЗагрузки = Новый HTTPЗапрос(ПутьЗагрузки);
    ЗапросЗагрузки.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросЗагрузки.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

    HTTPОтвет = СоединениеЗагрузки.ВызватьHTTPМетод("PUT", ЗапросЗагрузки);

    КодОтвета = HTTPОтвет.КодСостояния;
    ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();

    Сообщить("HTTP status: " + КодОтвета);
    Сообщить("Путь на Яндекс.Диске: " + ПутьНаДиске);
    Сообщить("Ответ сервера: " + ТекстОтвета);
    Сообщить("Успешные коды загрузки: 201 (создан) или 202 (принят в обработку).");

    // Автозакрытие 1С намеренно отключено на время проверки. Когда всё
    // подтвердится — можно вернуть (см. CLAUDE.md, раздел 28):
    // ЗавершитьРаботуСистемы();

КонецПроцедуры

// ============================================================================
// ВРЕМЕННАЯ ДИАГНОСТИКА - НЕ ЧАСТЬ ВЫГРУЗКИ
// ============================================================================
// Единоразовая проверка: что реально лежит в РегистрНакопления.
// ВзаиморасчетыКомпании - есть ли там дата движения, ссылка на документ-
// регистратор (сам платёж) и т.п. Ничего никуда не отправляет и не
// изменяет - только выводит текст через Сообщить(). Как запустить:
//
//   1. В процедуре ПриОткрытии() ниже уже есть обе строки - реальная
//      выгрузка и вызов диагностики; активна (не закомментирована) всегда
//      только одна. Для диагностики: закомментируйте
//      "КнопкаВыполнитьНажатие(Неопределено);" и раскомментируйте
//      "ДиагностикаРегистраВзаиморасчетов();" (или наоборот для реальной
//      выгрузки).
//   2. Откройте/запустите TestExportOrders.epf как обычно.
//   3. Скопируйте весь вывод из окна сообщений 1С (там будут строки вида
//      "Период=...; Регистратор=...; ...") и пришлите мне.
// ============================================================================

// Печатает все движения регистра по одной Сделке, плюс сумму строк
// ВидДвижения=Расход (то самое правило, которым мы фильтруем платежи в
// выгрузке) - чтобы сравнить с Остатки().
Процедура НапечататьДвиженияПоСделке(Сделка, Подпись)

    ЗапросОстатка = Новый Запрос;
    ЗапросОстатка.Текст =
    "ВЫБРАТЬ
    | Остатки.СуммаОстаток КАК СуммаОстаток
    |ИЗ
    | РегистрНакопления.ВзаиморасчетыКомпании.Остатки(, Сделка = &Сделка) КАК Остатки";
    ЗапросОстатка.УстановитьПараметр("Сделка", Сделка);
    ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
    Если ВыборкаОстатка.Следующий() Тогда
        Сообщить(Подпись + ": Остатки()=" + Строка(ВыборкаОстатка.СуммаОстаток));
    Иначе
        Сообщить(Подпись + ": Остатки()=0 (нет строки в Остатки())");
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ *
    |ИЗ
    | РегистрНакопления.ВзаиморасчетыКомпании КАК ВзаиморасчетыКомпании
    |ГДЕ
    | ВзаиморасчетыКомпании.Сделка = &Сделка
    |УПОРЯДОЧИТЬ ПО
    | ВзаиморасчетыКомпании.Период";
    Запрос.УстановитьПараметр("Сделка", Сделка);
    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Сообщить(Подпись + ": движений нет.");
        Возврат;
    КонецЕсли;

    СуммаРасход = 0;
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Строка = "";
        Для Каждого Колонка Из Результат.Колонки Цикл
            Строка = Строка + Колонка.Имя + "=" + Строка(Выборка[Колонка.Имя]) + "; ";
        КонецЦикла;
        Сообщить(Строка);
        Если Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
            СуммаРасход = СуммаРасход + Выборка.Сумма;
        КонецЕсли;
    КонецЦикла;

    Сообщить(Подпись + ": Сумма всех строк Расход=" + Строка(СуммаРасход));

КонецПроцедуры

// Ищет движения регистра по РЕГИСТРАТОРУ (не по Сделке) - для конкретных
// документов, чьи номера уже известны (например, из "Дерево подчинённости"
// в 1С), чтобы увидеть, проведены ли они вообще и какой Сделкой помечены
// их движения. ВЫРАЗИТЬ(... КАК СТРОКА(N)) здесь работает (в отличие от
// попытки с ВидОперации) - Регистратор действительно составной тип
// (ссылка на много видов документов), а не перечисление.
Процедура ДиагностикаПоискПоНомерамДокументов()

    // Без фильтра по Регистратору в запросе (составные ссылки не удаётся
    // привести/сравнить в языке запросов в этой конфигурации - см. историю
    // ошибок выше). Вместо этого читаем все движения за период и сравниваем
    // Регистратор текстом уже в обычном коде через Строка(...) - этот
    // способ уже проверенно работает в остальной части файла.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ *
    |ИЗ
    | РегистрНакопления.ВзаиморасчетыКомпании КАК ВзаиморасчетыКомпании
    |ГДЕ
    | ВзаиморасчетыКомпании.Период МЕЖДУ &ДатаС И &ДатаПо
    |УПОРЯДОЧИТЬ ПО
    | ВзаиморасчетыКомпании.Период";

    Запрос.УстановитьПараметр("ДатаС", Дата(2026, 4, 1));
    Запрос.УстановитьПараметр("ДатаПо", Дата(2026, 9, 1));

    Результат = Запрос.Выполнить();

    Сообщить("--- Движения с Регистратором ПМ00000021 / ПМ00000015 / ЭП0033756 ---");

    Если Результат.Пустой() Тогда
        Сообщить("За период вообще нет движений.");
        Возврат;
    КонецЕсли;

    Найдено = Ложь;
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        ТекстРегистратора = Строка(Выборка.Регистратор);
        Если Найти(ТекстРегистратора, "ПМ00000021") > 0
            ИЛИ Найти(ТекстРегистратора, "ПМ00000015") > 0
            ИЛИ Найти(ТекстРегистратора, "ЭП0033756") > 0 Тогда

            Найдено = Истина;
            Строка = "";
            Для Каждого Колонка Из Результат.Колонки Цикл
                Строка = Строка + Колонка.Имя + "=" + Строка(Выборка[Колонка.Имя]) + "; ";
            КонецЦикла;
            Сообщить(Строка);
        КонецЕсли;
    КонецЦикла;

    Если Не Найдено Тогда
        Сообщить("Ничего не найдено среди движений за период - эти документы либо не проведены, либо вне диапазона дат.");
    КонецЕсли;

    Сообщить("ДИАГНОСТИКА ЗАВЕРШЕНА.");

КонецПроцедуры

Процедура ДиагностикаРегистраВзаиморасчетов()

    ЗапросЗН = Новый Запрос;
    ЗапросЗН.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    | ЗаказНаряд.Ссылка КАК Ссылка,
    | ЗаказНаряд.Номер КАК Номер,
    | ЗаказНаряд.ДокументОснование КАК ДокументОснование,
    | ЗаказНаряд.ДокументОснование.ДокументОснование КАК ОснованиеОснования
    |ИЗ
    | Документ.ЗаказНаряд КАК ЗаказНаряд
    |ГДЕ
    | ЗаказНаряд.Номер = &Номер";

    ЗапросЗН.УстановитьПараметр("Номер", "ПМ00000170");

    РезультатЗН = ЗапросЗН.Выполнить();
    ВыборкаЗН = РезультатЗН.Выбрать();

    Если Не ВыборкаЗН.Следующий() Тогда
        Сообщить("ДИАГНОСТИКА: заказ-наряд не найден.");
        Возврат;
    КонецЕсли;

    Сообщить("ДИАГНОСТИКА: заказ-наряд " + ВыборкаЗН.Номер);

    НапечататьДвиженияПоСделке(ВыборкаЗН.Ссылка, "Сделка=Сам ЗН");

    Если ЗначениеЗаполнено(ВыборкаЗН.ДокументОснование) Тогда
        Сообщить("ДокументОснование=" + Строка(ВыборкаЗН.ДокументОснование));
        НапечататьДвиженияПоСделке(ВыборкаЗН.ДокументОснование, "Сделка=ДокументОснование");
    Иначе
        Сообщить("ДокументОснование не заполнено.");
    КонецЕсли;

    Если ЗначениеЗаполнено(ВыборкаЗН.ОснованиеОснования) Тогда
        Сообщить("ОснованиеОснования=" + Строка(ВыборкаЗН.ОснованиеОснования));
        НапечататьДвиженияПоСделке(ВыборкаЗН.ОснованиеОснования, "Сделка=ОснованиеОснования");
    Иначе
        Сообщить("ОснованиеОснования не заполнено.");
    КонецЕсли;

    Сообщить("ДИАГНОСТИКА ЗАВЕРШЕНА.");

КонецПроцедуры

