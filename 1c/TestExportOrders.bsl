// ============================================================================
// TestExportOrders.epf — object module (полный текст модуля обработки)
// ============================================================================
//
// ВАРИАНТ ЧЕРЕЗ ЯНДЕКС.ДИСК REST API (не WebDAV!) — обходной путь на случай,
// если сеть 5Systems блокирует прямое HTTPS-соединение с Railway (firewall
// режет исходящий трафик на IP-диапазоны облачного хостинга). Вместо прямого
// POST в наш backend этот вариант кладёт JSON-файл на Яндекс.Диск через его
// REST API; backend сам периодически проверяет папку и импортирует новые
// файлы через тот же самый код, что и прямой API (см.
// backend/app/services/yandex_relay.py, DEPLOYMENT.md).
//
// ВАЖНО: изначально этот модуль использовал протокол WebDAV
// (webdav.yandex.ru) с Basic-авторизацией (логин + пароль приложения). Яндекс
// вернул "402 Payment Required: WebDAV is not available for the free
// tariff" — WebDAV у Яндекс.Диска доступен только на платных тарифах.
// Поэтому здесь используется REST API (cloud-api.yandex.net) с OAuth-
// токеном — тем же самым токеном, что уже настроен на backend
// (переменная окружения YANDEX_DISK_OAUTH_TOKEN в Railway), без ограничений
// по тарифу. Отдельный логин/пароль приложения больше не нужен.
//
// Это ПОЛНЫЙ текст модуля — весь код, который должен быть в редакторе модуля
// формы обработки. Форма (кнопка "Выполнить" и т.п.) — отдельные, не текстовые
// метаданные Конфигуратора; их менять не нужно. Событие ПриОткрытии уже
// привязано к процедуре ПриОткрытии() ниже (см. CLAUDE.md, раздел 25).
//
// Перед запуском замените ОДИН плейсхолдер ниже:
//   <YANDEX_OAUTH_TOKEN> — тот же OAuth-токен, что уже стоит в Railway
//                          (переменная YANDEX_DISK_OAUTH_TOKEN)
// ============================================================================

Процедура КнопкаВыполнитьНажатие(Кнопка)

    // --- 1. Запрос: последние 10 заказ-нарядов ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 10
    | ЗаказНаряд.Номер КАК Номер,
    | ЗаказНаряд.Дата КАК Дата,
    | ЗаказНаряд.Контрагент КАК Контрагент,
    | ЗаказНаряд.Автомобиль КАК Автомобиль,
    | ЗаказНаряд.СуммаДокумента КАК СуммаДокумента,
    | ЗаказНаряд.Ссылка КАК Ссылка
    |ИЗ
    | Документ.ЗаказНаряд КАК ЗаказНаряд
    |
    |УПОРЯДОЧИТЬ ПО
    | ЗаказНаряд.Дата УБЫВ";

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    // --- 2. Собираем records[] под контракт бэкенда (не меняется от того,
    //        через какой транспорт файл в итоге попадёт в backend) ---
    МассивЗаписей = Новый Массив;

    Пока Выборка.Следующий() Цикл

        Запись = Новый Структура;
        Запись.Вставить("number", Строка(Выборка.Номер));
        Запись.Вставить("date", Выборка.Дата);
        Запись.Вставить("customer", Строка(Выборка.Контрагент));
        Запись.Вставить("car", Строка(Выборка.Автомобиль));
        Запись.Вставить("amount", Выборка.СуммаДокумента);
        Запись.Вставить("source_key", Строка(Выборка.Ссылка.УникальныйИдентификатор()));

        МассивЗаписей.Добавить(Запись);

    КонецЦикла;

    // --- 3. Собираем конверт батча под /api/v1/import/work-orders (тот же
    //        JSON-контракт, что и при прямой отправке в Railway) ---
    Данные = Новый Структура;
    Данные.Вставить("source", "alpha-auto");
    Данные.Вставить("branch", "kahovka"); // при необходимости поменяйте на реальный филиал
    Данные.Вставить("entity", "work_orders");
    Данные.Вставить("exported_at", Формат(ТекущаяДата(), "ДФ=гггг-ММ-ддTчч:мм:сс"));
    ИдБатча = Формат(ТекущаяДата(), "ДФ=ггггММдд-ччммсс");
    Данные.Вставить("batch_id", ИдБатча);
    Данные.Вставить("records", МассивЗаписей);

    // --- 4. Сериализация в JSON ---
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ТелоJSON = ЗаписьJSON.Закрыть();

    // --- 5. Загрузка на Яндекс.Диск через REST API (не WebDAV) ---
    OAuthТокен = "<YANDEX_OAUTH_TOKEN>";
    ПутьНаДиске = "/1c-export/" + ИдБатча + ".json";

    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;

    // 5a. Запрашиваем у Яндекса одноразовую ссылку для загрузки файла.
    СоединениеAPI = Новый HTTPСоединение(
        "cloud-api.yandex.net",
        443,
        ,
        ,
        ,
        ,
        ЗащищенноеСоединение
    );

    ЗапросСсылки = Новый HTTPЗапрос("/v1/disk/resources/upload");
    ЗапросСсылки.Заголовки.Вставить("Authorization", "OAuth " + OAuthТокен);
    ЗапросСсылки.ПараметрыURL.Вставить("path", ПутьНаДиске);
    ЗапросСсылки.ПараметрыURL.Вставить("overwrite", "true");

    ОтветСсылки = СоединениеAPI.ВызватьHTTPМетод("GET", ЗапросСсылки);

    Если ОтветСсылки.КодСостояния <> 200 Тогда
        Сообщить("Не удалось получить ссылку для загрузки. HTTP status: " + ОтветСсылки.КодСостояния);
        Сообщить("Ответ сервера: " + ОтветСсылки.ПолучитьТелоКакСтроку());
        Возврат;
    КонецЕсли;

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ОтветСсылки.ПолучитьТелоКакСтроку());
    ДанныеСсылки = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();

    ХрефЗагрузки = ДанныеСсылки.href;

    // 5b. Разбираем полученную ссылку на хост и путь - она обычно ведёт на
    //     отдельный сервер загрузки (не cloud-api.yandex.net).
    БезСхемы = СтрЗаменить(ХрефЗагрузки, "https://", "");
    ПозицияСлеша = СтрНайти(БезСхемы, "/");
    Если ПозицияСлеша > 0 Тогда
        ХостЗагрузки = Лев(БезСхемы, ПозицияСлеша - 1);
        ПутьЗагрузки = Сред(БезСхемы, ПозицияСлеша);
    Иначе
        ХостЗагрузки = БезСхемы;
        ПутьЗагрузки = "/";
    КонецЕсли;

    // 5c. Собственно загрузка файла на полученную ссылку.
    ЗащищенноеСоединение2 = Новый ЗащищенноеСоединениеOpenSSL;

    СоединениеЗагрузки = Новый HTTPСоединение(
        ХостЗагрузки,
        443,
        ,
        ,
        ,
        ,
        ЗащищенноеСоединение2
    );

    ЗапросЗагрузки = Новый HTTPЗапрос(ПутьЗагрузки);
    ЗапросЗагрузки.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросЗагрузки.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

    HTTPОтвет = СоединениеЗагрузки.ВызватьHTTPМетод("PUT", ЗапросЗагрузки);

    КодОтвета = HTTPОтвет.КодСостояния;
    ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();

    Сообщить("HTTP status: " + КодОтвета);
    Сообщить("Путь на Яндекс.Диске: " + ПутьНаДиске);
    Сообщить("Ответ сервера: " + ТекстОтвета);
    Сообщить("Успешные коды загрузки: 201 (создан) или 202 (принят в обработку).");

    // Автозакрытие 1С намеренно отключено на время проверки. Когда всё
    // подтвердится — можно вернуть (см. CLAUDE.md, раздел 28):
    // ЗавершитьРаботуСистемы();

КонецПроцедуры

Процедура ПриОткрытии()

    КнопкаВыполнитьНажатие(Неопределено);

КонецПроцедуры
