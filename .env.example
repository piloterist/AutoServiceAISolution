# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored - never commit real secrets.
#
# This file holds LOCAL/DOCKER-COMPOSE DEFAULTS ONLY. Every deployed client
# instance gets its own set of these values (its own DB credentials, its own
# API_TOKEN, its own hostnames) - none of it is hardcoded in the application.

# --- PostgreSQL (used by docker-compose to boot the postgres container) ---
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoservice
POSTGRES_PORT=5432

# --- Backend ---
# Full SQLAlchemy URL. In docker-compose this is composed from the POSTGRES_*
# vars above; set it directly when running the backend outside compose or
# against an external/managed PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://autoservice:change-me@localhost:5432/autoservice
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://autoservice:change-me@localhost:5432/autoservice_test

# Shared-secret bearer token the 1C/Alpha-Auto integration must send as
# `Authorization: Bearer <API_TOKEN>`. Unique per deployed instance.
API_TOKEN=change-me-integration-token

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Comma-separated work order status value(s) that count as recognized
# revenue on the dashboard's reporting endpoints (monthly summary,
# by-department summary) - e.g. "Закрыт". An open/in-progress work order
# still shows up on the work orders list, it just isn't counted as earned
# revenue until it reaches one of these statuses. Leave empty (default) to
# not restrict by status at all - the exact status string is per-client
# data (see ARCHITECTURE.md), not something the core hardcodes.
REVENUE_STATUSES=

# --- Optional module: Yandex.Disk relay (see DEPLOYMENT.md) ---
# Only needed for a client instance whose 1C server cannot reach this
# backend's own domain directly (outbound firewall blocking cloud-hosting IP
# ranges). Leave disabled unless you have that specific problem.
ENABLE_YANDEX_RELAY=false
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_WATCH_PATH=/1c-export
YANDEX_POLL_INTERVAL_SECONDS=300

# --- Optional module: live 5Systems plate lookup (see DEPLOYMENT.md and
# app/services/fivesystems_client.py's module docstring) ---
# Pan Motors/5Systems-specific: the Planner's "Получить ЗН" fallback, for a
# work order the once-daily 1C export hasn't reached yet. Leave disabled for
# any client not on 5Systems/Alpha-Auto.
ENABLE_FIVESYSTEMS_LOOKUP=false
FIVESYSTEMS_API_BASE_URL=https://api.5systems.ru
FIVESYSTEMS_USERNAME=
FIVESYSTEMS_PASSWORD=
FIVESYSTEMS_COMPANY_UUID=

# --- Frontend ---
# Where the browser's health-check widget looks, and (by default) where the
# frontend's own server fetches Work Order data from. Point this at whatever
# backend instance you want the frontend to display - local docker-compose,
# or a deployed instance (e.g. Railway) if that's where the real data is.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only (no NEXT_PUBLIC_ prefix - never sent to the browser).
# Must equal that backend instance's own API_TOKEN. Used by the frontend's
# Server Components to call the protected backend API - the browser never
# holds this token directly (see frontend/lib/backend-api.ts).
BACKEND_API_TOKEN=change-me-integration-token

# Signs the per-user login session cookie (see frontend/lib/auth.ts,
# middleware.ts) - login/password are verified against the backend's users
# table (see backend/app/models/user.py), not env vars. Generate a random
# value per instance, e.g. `openssl rand -hex 32` - never reuse across
# client instances, and rotating it logs every user out.
AUTH_SECRET=change-me-random-64-hex-chars
