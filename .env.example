# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored - never commit real secrets.
#
# This file holds LOCAL/DOCKER-COMPOSE DEFAULTS ONLY. Every deployed client
# instance gets its own set of these values (its own DB credentials, its own
# API_TOKEN, its own hostnames) - none of it is hardcoded in the application.

# --- PostgreSQL (used by docker-compose to boot the postgres container) ---
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoservice
POSTGRES_PORT=5432

# --- Backend ---
# Full SQLAlchemy URL. In docker-compose this is composed from the POSTGRES_*
# vars above; set it directly when running the backend outside compose or
# against an external/managed PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://autoservice:change-me@localhost:5432/autoservice
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://autoservice:change-me@localhost:5432/autoservice_test

# Shared-secret bearer token the 1C/Alpha-Auto integration must send as
# `Authorization: Bearer <API_TOKEN>`. Unique per deployed instance.
API_TOKEN=change-me-integration-token

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Optional module: Yandex.Disk relay (see DEPLOYMENT.md) ---
# Only needed for a client instance whose 1C server cannot reach this
# backend's own domain directly (outbound firewall blocking cloud-hosting IP
# ranges). Leave disabled unless you have that specific problem.
ENABLE_YANDEX_RELAY=false
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_WATCH_PATH=/1c-export
YANDEX_POLL_INTERVAL_SECONDS=300

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
